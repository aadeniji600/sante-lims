<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<!--
    ForcePassword.fxml
    Shown when a user logs in for the first time (is_first_login = TRUE).
    They MUST set a new password before they can access their dashboard.
    This applies to Super Admin and Lab Attendant accounts created by admin.
-->
<StackPane xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.lims.controller.auth.ForcePasswordController"
           style="-fx-background-color: #f0f4f8;">

    <VBox alignment="CENTER" spacing="0"
          maxWidth="420"
          style="-fx-background-color: white;
                 -fx-background-radius: 12;
                 -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.15), 20, 0, 0, 4);
                 -fx-padding: 48;">

        <Label text="Set Your Password"
               style="-fx-font-size: 24px;
                      -fx-font-weight: bold;
                      -fx-text-fill: #1a73e8;"/>

        <Label text="You must change your password before continuing."
               wrapText="true"
               style="-fx-font-size: 12px;
                      -fx-text-fill: #888;
                      -fx-padding: 0 0 28 0;"/>

        <Label text="New Password"
               style="-fx-font-size: 13px; -fx-font-weight: bold;
                      -fx-text-fill: #333; -fx-padding: 0 0 4 0;"
               maxWidth="Infinity"/>
        <PasswordField fx:id="newPasswordField" promptText="Enter new password"
                       style="-fx-font-size: 13px; -fx-padding: 10;
                              -fx-background-radius: 6; -fx-border-color: #ddd;
                              -fx-border-radius: 6;">
            <VBox.margin><Insets bottom="14"/></VBox.margin>
        </PasswordField>

        <Label text="Confirm New Password"
               style="-fx-font-size: 13px; -fx-font-weight: bold;
                      -fx-text-fill: #333; -fx-padding: 0 0 4 0;"
               maxWidth="Infinity"/>
        <PasswordField fx:id="confirmPasswordField" promptText="Repeat new password"
                       style="-fx-font-size: 13px; -fx-padding: 10;
                              -fx-background-radius: 6; -fx-border-color: #ddd;
                              -fx-border-radius: 6;">
            <VBox.margin><Insets bottom="8"/></VBox.margin>
        </PasswordField>

        <Label fx:id="errorLabel" text="" wrapText="true"
               style="-fx-text-fill: #d32f2f; -fx-font-size: 12px;"
               visible="false">
            <VBox.margin><Insets bottom="8"/></VBox.margin>
        </Label>

        <Button text="Save Password" maxWidth="Infinity"
                onAction="#handleSavePassword"
                style="-fx-background-color: #1a73e8; -fx-text-fill: white;
                       -fx-font-size: 14px; -fx-font-weight: bold;
                       -fx-padding: 12; -fx-background-radius: 6;
                       -fx-cursor: hand;"/>
    </VBox>
</StackPane>
