<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.layout.Region?>

<VBox prefHeight="600.0" prefWidth="800.0" spacing="20.0" style="-fx-background-color: #f4f6f9;" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.lims.controller.customer.ResultVaultController">
   
<padding>
        <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
    </padding>
<HBox alignment="CENTER_LEFT" spacing="20.0" style="-fx-background-color: #2c3e50; -fx-padding: 15px; -fx-background-radius: 5px;">
        <Button mnemonicParsing="false" onAction="#goToDashboard" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-background-radius: 4px; -fx-cursor: hand; -fx-padding: 8px 15px;" text="Patient Dashboard">
            <font><Font name="System Bold" size="14.0" /></font>
        </Button>
        <Button mnemonicParsing="false" onAction="#goToTestBrowser" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-background-radius: 4px; -fx-cursor: hand; -fx-padding: 8px 15px;" text="Order Tests">
            <font><Font name="System Bold" size="14.0" /></font>
        </Button>
        <Button mnemonicParsing="false" onAction="#goToResultVault" style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-background-radius: 4px; -fx-cursor: hand; -fx-padding: 8px 15px;" text="Result Vault">
            <font><Font name="System Bold" size="14.0" /></font>
        </Button>

        <Region HBox.hgrow="ALWAYS" />

        <Button mnemonicParsing="false" onAction="#handleLogout" style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-background-radius: 4px; -fx-cursor: hand; -fx-padding: 8px 15px;" text="Log Out">
            <font><Font name="System Bold" size="14.0" /></font>
        </Button>
    </HBox>

    <VBox spacing="5.0">
        <Label text="Secure Result Vault" textFill="#2c3e50">
            <font>
                <Font name="System Bold" size="28.0" />
            </font>
        </Label>
        <Label text="View and download your officially validated medical reports." textFill="#7f8c8d">
            <font>
                <Font size="14.0" />
            </font>
        </Label>
    </VBox>

    <TableView fx:id="resultTable" VBox.vgrow="ALWAYS" style="-fx-border-color: #bdc3c7; -fx-border-radius: 3px;">
        <columns>
            <TableColumn fx:id="testNameCol" prefWidth="400.0" text="Medical Test" />
            <TableColumn fx:id="dateCol" prefWidth="250.0" text="Date Validated" />
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
    </TableView>

    <HBox alignment="CENTER_RIGHT" spacing="15.0">
        <Button mnemonicParsing="false" onAction="#handleViewDocument" style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-background-radius: 5px; -fx-cursor: hand;" text="View Document">
            <font>
                <Font name="System Bold" size="14.0" />
            </font>
            <padding>
                <Insets bottom="10.0" left="25.0" right="25.0" top="10.0" />
            </padding>
        </Button>
    </HBox>

</VBox>

