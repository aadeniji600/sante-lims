<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import java.net.URL?>

<BorderPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.lims.controller.attendant.AttendantDashboardController">
    
    <stylesheets>
        <URL value="@/app.css"/>
    </stylesheets>

    <top>
        <HBox styleClass="topbar" alignment="CENTER_LEFT" spacing="12">
            <padding><Insets top="10" right="16" bottom="10" left="16"/></padding>
            <Label text="Lab Attendant" styleClass="topbar-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="userLabel" styleClass="topbar-user"/>
            <Button text="Logout" onAction="#logout" styleClass="ghost-btn"/>
        </HBox>
    </top>
    <center>
        <TabPane tabClosingPolicy="UNAVAILABLE">
            <tabs>
                <Tab text="Test Request Queue">
                    <content><fx:include source="RequestQueue.fxml"/></content>
                </Tab>
                <Tab text="Sample Tracking">
                    <content><fx:include source="SampleTracking.fxml"/></content>
                </Tab>
                <Tab text="Result Upload &amp; Validation">
                    <content><fx:include source="ResultUpload.fxml"/></content>
                </Tab>
            </tabs>
        </TabPane>
    </center>
</BorderPane>
