<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>
<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.lims.controller.customer.CustomerDashboardController">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="20.0"
              style="-fx-background-color: #2c3e50; -fx-padding: 15px;">
            <Button text="Patient Dashboard" onAction="#goToDashboard"
                    style="-fx-background-color: #3498db; -fx-text-fill: white;
                           -fx-background-radius: 4px; -fx-cursor: hand; -fx-padding: 8px 15px;"/>
            <Button text="Order Tests" onAction="#goToTestBrowser"
                    style="-fx-background-color: #3498db; -fx-text-fill: white;
                           -fx-background-radius: 4px; -fx-cursor: hand; -fx-padding: 8px 15px;"/>
            <Button text="Result Vault" onAction="#goToResultVault"
                    style="-fx-background-color: #3498db; -fx-text-fill: white;
                           -fx-background-radius: 4px; -fx-cursor: hand; -fx-padding: 8px 15px;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Log Out" onAction="#handleLogout"
                    style="-fx-background-color: #e74c3c; -fx-text-fill: white;
                           -fx-background-radius: 4px; -fx-cursor: hand; -fx-padding: 8px 15px;"/>
        </HBox>
    </top>
    <center>
        <VBox spacing="20.0" style="-fx-padding: 30; -fx-background-color: #f4f6f9;">
            <Label fx:id="welcomeLabel"
                   style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
            <Label text="Your Test Orders"
                   style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
            <Label fx:id="tatTimerLabel"
                   style="-fx-font-size: 14px; -fx-text-fill: #e67e22;"/>
            <TableView fx:id="ordersTable" VBox.vgrow="ALWAYS"
                       onMouseClicked="#handleOrderSelection">
                <columns>
                    <TableColumn fx:id="orderIdCol" text="Order ID" prefWidth="100"/>
                    <TableColumn fx:id="statusCol" text="Payment Status" prefWidth="200"/>
                    <TableColumn fx:id="readyAtCol" text="Expected Ready At" prefWidth="300"/>
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
            </TableView>
        </VBox>
    </center>
</BorderPane>